# Copy to .env for local development (never commit .env)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mintbloom?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Local email sink: node scripts/email-sink.mjs
POLSIA_EMAIL_PROXY_URL="http://127.0.0.1:3199"
POLSIA_OWNER_EMAIL="owner@example.com"
POLSIA_COMPANY_EMAIL="owner@example.com"
POLSIA_API_KEY="local-dev-key"
