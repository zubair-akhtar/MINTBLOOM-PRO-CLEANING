// @polsia:user-owned — statewide hiring markets, openings, and public applications.

enum JobOpeningStatus {
  draft
  published
  closed
}

model ServiceMarket {
  id           String           @id @default(cuid())
  name         String
  state        String
  city         String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  openings     JobOpening[]
  applications JobApplication[]

  @@unique([city, state])
  @@index([state, isActive])
}

model JobOpening {
  id             String           @id @default(cuid())
  title          String
  role           String
  employmentArea String
  state          String
  city           String
  schedule       String
  requirements   String
  compensation   String?
  status         JobOpeningStatus @default(draft)
  publishedAt    DateTime?
  closedAt       DateTime?
  marketId       String
  market         ServiceMarket    @relation(fields: [marketId], references: [id])
  applications   JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, closedAt])
  @@index([marketId])
}

model JobApplication {
  id           String        @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  roleInterest String
  availability String
  experience   String?
  message      String?
  consent      Boolean
  openingId    String?
  opening      JobOpening?   @relation(fields: [openingId], references: [id], onDelete: SetNull)
  marketId     String?
  market       ServiceMarket? @relation(fields: [marketId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([createdAt])
  @@index([openingId])
  @@index([marketId])
  @@index([email])
}
