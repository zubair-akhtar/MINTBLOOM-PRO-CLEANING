// @polsia:user-owned — visit completion reports and customer re-clean requests.

enum VisitCompletionStatus {
  completed
  needs_attention
  cancelled
}

model Visit {
  id                String               @id @default(cuid())
  bookingId         String?
  customerUserId    String?
  customerEmail     String
  serviceDate       DateTime             @db.Date
  serviceType       String
  serviceDetails    String?
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  zip               String
  completionStatus  VisitCompletionStatus @default(completed)
  completionSummary String?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  photos            VisitSpotCheckPhoto[]
  recleanRequests   RecleanRequest[]

  @@index([bookingId])
  @@index([customerUserId])
  @@index([customerEmail])
  @@index([serviceDate])
}

model VisitSpotCheckPhoto {
  id           String   @id @default(cuid())
  visitId      String
  url          String
  altText      String
  caption      String?
  capturedAt   DateTime
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, displayOrder])
}

enum RecleanRequestStatus {
  active
  resolved
  cancelled
}

model RecleanRequest {
  id              String              @id @default(cuid())
  visitId         String
  requesterUserId String
  status          RecleanRequestStatus @default(active)
  reason          String?
  activeKey       String?             @unique
  createdAt       DateTime            @default(now())
  resolvedAt      DateTime?
  visit           Visit               @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, status])
  @@index([requesterUserId])
}
