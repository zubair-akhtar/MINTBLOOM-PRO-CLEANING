// @polsia:framework-owned
model ServiceIntakeRequest {
  id            String                    @id
  reference     String                    @unique
  scope         String
  attemptId     String                    @map("attempt_id")
  digest        String
  snapshot      Json
  answers       Json
  contact       String
  status        String                    @default("received")
  note          String                    @default("")
  version       Int                       @default(1)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  history       ServiceIntakeHistory[]
  notification  ServiceIntakeNotification?

  @@unique([scope, attemptId], map: "service_intake_requests_scope_attempt_id_key")
  @@index([scope, createdAt(sort: Desc), id], map: "service_intake_requests_scope_created_idx")
  @@index([scope, status, createdAt(sort: Desc)], map: "service_intake_requests_scope_status_idx")
  @@map("service_intake_requests")
}

model ServiceIntakeHistory {
  id         String               @id
  requestId  String               @map("request_id")
  fromStatus String?              @map("from_status")
  toStatus   String               @map("to_status")
  actorId    String?              @map("actor_id")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz
  request    ServiceIntakeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([requestId, createdAt], map: "service_intake_history_request_idx")
  @@map("service_intake_history")
}

model ServiceIntakeNotification {
  requestId  String               @id @map("request_id")
  status     String               @default("pending")
  attempts   Int                  @default(0)
  lastError  String?              @map("last_error")
  leaseUntil DateTime?            @map("lease_until") @db.Timestamptz
  token      String?
  request    ServiceIntakeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("service_intake_notifications")
}

model ServiceIntakeRateBucket {
  key         String   @id
  count       Int
  windowStart DateTime @default(now()) @map("window_start") @db.Timestamptz

  @@map("service_intake_rate_buckets")
}
