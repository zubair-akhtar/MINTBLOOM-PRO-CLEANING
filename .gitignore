# Polsia Next.js template — gitignore (Node + Next.js + tools)

# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
/out/
next-env.d.ts

# Production builds
/build/
/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Env files: never commit .env*
# Block every .env* variant (.env, .env.local, .env.production, .env.staging, …)
# and keep only the committed .env.example documenting the shape.
.env*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Testing
/coverage/
/playwright-report/
/test-results/

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Polsia local / upgrade sidecars
.polsia/
*.polsia-app-old

# Polsia production downloads (keep on disk, never push)
latest-code/
latest-code-production-v3/
latest-code-production-v3 v1.0/
*.zip

# Handoff / upload packs for Polsia chat (local only)
to-be-upload/
polsia-parts/
polsia-parts-small/
POLSIA-COMPLETE-HANDOFF.txt
docs/polsia-handoff*
Mintbloom_Pricing_Calculator_Specification-2.pdf
